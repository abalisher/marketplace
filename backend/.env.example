# Backend (Medusa v2) — пример окружения. Скопируй в backend/.env и подставь значения.
# Значения по умолчанию совпадают с infra/docker-compose.yml (postgres/redis).

# Подключение к БД и Redis из infra/docker-compose.yml (порты проброшены на localhost).
DATABASE_URL=postgres://medusa:medusa@localhost:5432/marketplace
REDIS_URL=redis://localhost:6379

# CORS: витрина покупателя (Next.js :8000), админка/dev-сервер (:9000/:5173).
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:5173,http://localhost:8000

# Секреты: в проде — только через окружение, не коммитить реальные значения.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Kaspi Pay / QR. Транспорт: mock (dev/тесты, без сети) | live (реальный эквайринг).
# По умолчанию mock, если ключи мерчанта не заданы. Публичной песочницы Kaspi нет —
# реальные KASPI_MERCHANT_ID/KASPI_API_KEY запросить у клиента (см. docs/modules/payment-kaspi.md).
KASPI_MODE=mock
KASPI_MERCHANT_ID=
KASPI_API_KEY=
# Только для live: адрес развёрнутого kaspi-automation-сервера (не kaspi.kz напрямую)
# и секрет подписи webhook (X-Webhook-Signature, HMAC SHA-256). Все четыре значения
# обязательны при KASPI_MODE=live.
KASPI_API_URL=
KASPI_WEBHOOK_SECRET=

# ИИ-фичи (ассистент покупателя + приёмка накладных): провайдер — Google Gemini.
# Ключ — только через env (секрет не в репо). GEMINI_MODEL вынесен, чтобы смена
# версии модели правилась без кода; по умолчанию gemini-3.5-flash-lite.
# Без ключа роут /admin/procurement/parse-invoice вернёт понятную ошибку — ручной
# приход при этом работает как прежде.
#
# ВЫБОР МОДЕЛИ (решение владельца 2026-08-03): рабочий режим — flash-lite, он
# дешевле. НА ПОКАЗАХ переключать на gemini-3.6-flash: A/B того же промпта показал,
# что flash не роняет правила промпта (lite иногда заявляет «у нас такого нет», не
# выполнив поиск), но отвечает в 2,5–3 раза медленнее. Перед демо:
#   GEMINI_MODEL=gemini-3.6-flash  → перезапустить бэкенд (npm run dev)
# Сравнение построчно — docs/qa/2026-08-03-assistant-quality-10-agents.md.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Вход покупателя по номеру телефона (T10.7, провайдер auth-phone).
# SMS-провайдера на MVP нет (гейт В у владельца): пока PHONE_OTP_DEV_CHANNEL=true
# код входа пишется в лог бэкенда и возвращается полем dev_code в ответе
# POST /store/auth/phone/otp. В production dev-канал выключен по умолчанию —
# без SMS-провайдера вход по номеру там работать не будет.
PHONE_OTP_DEV_CHANNEL=true
# Срок жизни кода (сек), лимит неверных попыток на один код и пауза перед
# повторной отправкой (сек); длина кода в цифрах.
PHONE_OTP_TTL_SECONDS=300
PHONE_OTP_MAX_ATTEMPTS=5
PHONE_OTP_RESEND_SECONDS=60
PHONE_OTP_CODE_LENGTH=6

# Панель продавца, дашборд «что требует внимания» (GET /admin/dashboard).
# Порог «низкого остатка» в единицах хранения: позиции с доступным количеством
# не выше порога попадают в KPI-карточку «Низкие остатки». Значение единое до
# наполнения боевого каталога (T7.1/T7.2), где пороги задаются по позициям.
DASHBOARD_LOW_STOCK_THRESHOLD=10

# Окно отчёта по стадиям заказа (принято → собрано → отгружено → доставлено) в
# днях: за какой период дашборд считает среднее время каждой стадии.
DASHBOARD_STAGE_REPORT_DAYS=30

# Часовой пояс магазина: «выручка за день» считается по его дню, а не по дню
# UTC-сервера (в Астане UTC+5 — иначе первые пять часов продаж уезжают в
# «вчера»). Любое имя из базы IANA.
SHOP_TIME_ZONE=Asia/Almaty

# Сроки обработки заказа по стадиям в часах: заказ, стоящий в статусе дольше
# срока, помечается в очереди «вне срока» и попадает в счётчик просрочки на
# дашборде. Формат — «статус=часы» через запятую; перечислять нужно только те
# статусы, чью норму меняем, остальные берут значение по умолчанию
# (new=2, confirmed=4, assembling=8, partially_assembled=8, assembled=12,
# in_delivery=24). Значение 0 — «срока нет».
# ORDER_SLA_HOURS=new=2,confirmed=4,assembled=12,in_delivery=24

# Срок ответа по претензии в часах: активная претензия старше срока считается
# просроченной (очередь «Претензии» и плитка дашборда).
DISPUTE_SLA_HOURS=24

# Учётка ОБЫЧНОГО ПРОДАВЦА для панели (`/app`) — её создаёт скрипт
#   npx medusa exec ./src/scripts/create-seller-user.ts
# Роль пишется в `user.metadata.role=seller`, и оболочка панели прячет от неё
# владельческие разделы (настройки магазина, ключи API, регионы, налоги, акции,
# прайс-листы) — см. src/admin/styles/shell.css. Учётка админа (ADMIN_EMAIL) роли
# не имеет и видит панель целиком. На проде задать свои значения.
SELLER_EMAIL=seller@stroymarket.kz
SELLER_PASSWORD=seller123456

# ФИЧА-ФЛАГИ.
# FEATURE_COMPANIES — юрлица целиком: регистрация компании и её модерация,
# оформление заказа от имени компании, скоринг и кредитный лимит, внутренний АВР.
# На MVP ВЫКЛЮЧЕН (разворот владельца 2026-08-25): магазин работает только с
# физлицами. Код, таблицы и данные не удалены — `true` возвращает всё обратно.
# Флаг сквозной: включая его на бэкенде, включи и на клиентах (их бандлы про env
# бэкенда не знают) и ПЕРЕСОБЕРИ их:
#   storefront/.env  NEXT_PUBLIC_FEATURE_COMPANIES=true
#   mobile           flutter build ... --dart-define=FEATURE_COMPANIES=true
#   панель продавца  собирается из этого же значения (npm run build в backend/)
FEATURE_COMPANIES=false

# Срок оплаты юрлица по отсрочке в днях: неоплаченный заказ компании старше
# срока попадает в «просрочено» на плитке долга юрлиц (дашборд). Читается
# только при FEATURE_COMPANIES=true.
COMPANY_RECEIVABLE_TERM_DAYS=14
