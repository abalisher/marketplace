{
  "paths": {
    "/admin/order-lifecycles": {
      "get": {
        "operationId": "GetOrderLifecycles",
        "summary": "List Order Lifecycle Queue",
        "description": "Очередь заказов по бизнес-статусу ТЗ. Отдельный ресурс, а не переопределение ядрового GET /admin/orders. Фильтр по статусу (одно значение или несколько), способу получения, поиск по номеру/почте, сортировка (дефолт — FIFO по created_at), пагинация. Каждая запись несёт заказ в виде готовой строки экрана «Заказы» (плательщик, число позиций, итог, оплата, адрес), а ответ — счётчики по статусам для чипов-фильтров.",
        "tags": [
          "Orders"
        ],
        "security": [
          {
            "jwt_token": []
          },
          {
            "cookie_auth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Фильтр по бизнес-статусу заказа. Одно значение или несколько через запятую («new,confirmed»). Описан ПРОСТОЙ строкой по той же причине, что и статус задания сборки: из oneOf кодогенератор Dart делает dynamic и зовёт toJson() (см. assembly-tasks.oas.json).",
            "schema": {
              "type": "string",
              "example": "new,confirmed"
            }
          },
          {
            "name": "delivery_method",
            "in": "query",
            "required": false,
            "description": "Фильтр по способу получения заказа.",
            "schema": {
              "type": "string",
              "enum": [
                "delivery"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Поиск: номер заказа (display_id, можно с «#») или email покупателя (частичное совпадение).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "Поле сортировки (префикс «-» — по убыванию).",
            "schema": {
              "type": "string",
              "enum": [
                "created_at",
                "-created_at",
                "updated_at",
                "-updated_at"
              ],
              "default": "created_at"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Страница очереди заказов.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOrderLifecycleListRes"
                }
              }
            }
          }
        }
      }
    },
