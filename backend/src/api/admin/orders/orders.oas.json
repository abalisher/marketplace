{
  "paths": {
    "/admin/order-lifecycles": {
      "get": {
        "operationId": "GetOrderLifecycles",
        "summary": "List Order Lifecycle Queue",
        "description": "Очередь заказов по бизнес-статусу ТЗ. Отдельный ресурс, а не переопределение ядрового GET /admin/orders. Фильтр по статусу, сортировка (дефолт — FIFO по created_at), пагинация. Каждая запись несёт связанный заказ (номер/почта/дата).",
        "tags": ["Orders"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Фильтр по бизнес-статусу заказа.",
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "confirmed",
                "assembling",
                "partially_assembled",
                "assembled",
                "in_delivery",
                "delivered",
                "closed",
                "canceled",
                "returned"
              ]
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "Поле сортировки (префикс «-» — по убыванию).",
            "schema": {
              "type": "string",
              "enum": [
                "created_at",
                "-created_at",
                "updated_at",
                "-updated_at"
              ],
              "default": "created_at"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Страница очереди заказов.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOrderLifecycleListRes"
                }
              }
            }
          }
        }
      }
    },
    "/admin/orders/{id}/lifecycle": {
      "get": {
        "operationId": "GetOrdersIdLifecycleAdmin",
        "summary": "Get Order Lifecycle Status (Admin)",
        "description": "Бизнес-статус заказа и полный лог переходов. 404 — заказ не найден.",
        "tags": ["Orders"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Статус заказа и история переходов.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOrderLifecycleRes"
                }
              }
            }
          }
        }
      }
    },
    "/admin/orders/{id}/lifecycle/confirm": {
      "post": {
        "operationId": "PostOrdersIdLifecycleConfirm",
        "summary": "Confirm Order",
        "description": "Подтверждение заявки менеджером: new → confirmed.",
        "tags": ["Orders"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Новый бизнес-статус заказа.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOrderStatusRes"
                }
              }
            }
          }
        }
      }
    },
    "/admin/orders/{id}/lifecycle/start-assembly": {
      "post": {
        "operationId": "PostOrdersIdLifecycleStartAssembly",
        "summary": "Start Order Assembly",
        "description": "Кладовщик начал комплектацию: confirmed → assembling.",
        "tags": ["Orders"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Новый бизнес-статус заказа.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOrderStatusRes"
                }
              }
            }
          }
        }
      }
    },
    "/admin/orders/{id}/lifecycle/complete-assembly": {
      "post": {
        "operationId": "PostOrdersIdLifecycleCompleteAssembly",
        "summary": "Complete Order Assembly",
        "description": "Сборка (в т.ч. частичная): ядровый createOrderFulfillment фиксирует физику, статус синхронизируется (полная → assembled, частичная → partially_assembled).",
        "tags": ["Orders"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCompleteAssembly"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Созданный fulfillment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOrderFulfillmentRes"
                }
              }
            }
          }
        }
      }
    },
    "/admin/orders/{id}/lifecycle/ship": {
      "post": {
        "operationId": "PostOrdersIdLifecycleShip",
        "summary": "Ship Order",
        "description": "Отгрузка: ядровый createOrderShipment (fulfillment → shipped), статус → in_delivery.",
        "tags": ["Orders"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminShipOrder" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Новый бизнес-статус заказа.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOrderStatusRes"
                }
              }
            }
          }
        }
      }
    },
    "/admin/orders/{id}/lifecycle/deliver": {
      "post": {
        "operationId": "PostOrdersIdLifecycleDeliver",
        "summary": "Deliver Order",
        "description": "Вручение: статус → delivered (для способа delivery обязателен верный код получения от покупателя; для pickup — выдача у окна по накладной, без кода), затем ядровый markOrderFulfillmentAsDelivered.",
        "tags": ["Orders"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminDeliverOrder" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Новый бизнес-статус заказа.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOrderStatusRes"
                }
              }
            }
          }
        }
      }
    },
    "/admin/orders/{id}/lifecycle/close": {
      "post": {
        "operationId": "PostOrdersIdLifecycleClose",
        "summary": "Close Order",
        "description": "Закрытие после окна возврата: ядровый completeOrder (order.status → completed), статус → closed.",
        "tags": ["Orders"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Новый бизнес-статус заказа.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOrderStatusRes"
                }
              }
            }
          }
        }
      }
    },
    "/admin/counter-orders": {
      "post": {
        "operationId": "PostCounterOrders",
        "summary": "Place Counter Order (POS)",
        "description": "Продажа у окна склада: продавец собрал корзину покупателя на месте, оплата авторизована — заказ создаётся сразу выданным (свёрнутый путь new → delivered, способ получения counter). Отдельный ресурс: статический сегмент под /admin/orders конфликтует с ядровым /admin/orders/{id}.",
        "tags": ["Orders"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminPlaceCounterOrder"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Созданный заказ и его жизненный цикл (delivered).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminPlaceCounterOrderRes"
                }
              }
            }
          }
        }
      }
    },
    "/admin/orders/{id}/lifecycle/cancel": {
      "post": {
        "operationId": "PostOrdersIdLifecycleCancel",
        "summary": "Cancel Order (Admin)",
        "description": "Отмена админом: ядровый cancelOrder (order.status → canceled), статус → canceled. Под /lifecycle/, чтобы не перекрывать ядровый POST /admin/orders/{id}/cancel.",
        "tags": ["Orders"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminCancelOrder" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Новый бизнес-статус заказа.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOrderStatusRes"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminOrderLineInput": {
        "type": "object",
        "required": ["id", "quantity"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Id позиции заказа (order line item)."
          },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      },
      "AdminCompleteAssembly": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/AdminOrderLineInput" }
          },
          "location_id": {
            "type": "string",
            "description": "Склад отгрузки (по умолчанию — из заказа)."
          }
        }
      },
      "AdminShipOrder": {
        "type": "object",
        "required": ["fulfillment_id", "items"],
        "properties": {
          "fulfillment_id": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AdminOrderLineInput" }
          }
        }
      },
      "AdminDeliverOrder": {
        "type": "object",
        "required": ["fulfillment_id"],
        "properties": {
          "fulfillment_id": { "type": "string" },
          "delivery_code": {
            "type": "string",
            "description": "Код получения от покупателя — обязателен для заказов со способом delivery."
          }
        }
      },
      "AdminPlaceCounterOrder": {
        "type": "object",
        "required": ["cart_id"],
        "properties": {
          "cart_id": {
            "type": "string",
            "description": "Корзина, собранная продавцом у окна (оплата уже авторизована)."
          },
          "location_id": {
            "type": "string",
            "description": "Склад выдачи (по умолчанию — из shipping option корзины)."
          }
        }
      },
      "AdminCancelOrder": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "Причина отмены (опционально; логируется)."
          }
        }
      },
      "AdminOrderLifecycleOrder": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "display_id": { "type": "integer", "nullable": true },
          "email": { "type": "string", "nullable": true },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "AdminOrderLifecycle": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "confirmed",
              "assembling",
              "partially_assembled",
              "assembled",
              "in_delivery",
              "delivered",
              "closed",
              "canceled",
              "returned"
            ]
          },
          "previous_status": { "type": "string", "nullable": true },
          "note": { "type": "string", "nullable": true },
          "delivery_method": {
            "type": "string",
            "enum": ["delivery", "pickup", "counter"],
            "description": "Способ получения заказа."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "order": {
            "$ref": "#/components/schemas/AdminOrderLifecycleOrder"
          }
        }
      },
      "AdminOrderLifecycleEvent": {
        "type": "object",
        "required": ["id", "to_status", "actor_type"],
        "properties": {
          "id": { "type": "string" },
          "from_status": { "type": "string", "nullable": true },
          "to_status": { "type": "string" },
          "actor_type": {
            "type": "string",
            "enum": ["buyer", "seller", "admin", "system"]
          },
          "actor_id": { "type": "string", "nullable": true },
          "reason": { "type": "string", "nullable": true },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "AdminOrderLifecycleListRes": {
        "type": "object",
        "required": ["order_lifecycles", "count", "offset", "limit"],
        "properties": {
          "order_lifecycles": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AdminOrderLifecycle" }
          },
          "count": { "type": "integer" },
          "offset": { "type": "integer" },
          "limit": { "type": "integer" }
        }
      },
      "AdminOrderLifecycleRes": {
        "type": "object",
        "required": ["order_id", "history"],
        "properties": {
          "order_id": { "type": "string" },
          "status": { "type": "string", "nullable": true },
          "previous_status": { "type": "string", "nullable": true },
          "note": { "type": "string", "nullable": true },
          "delivery_method": {
            "type": "string",
            "enum": ["delivery", "pickup", "counter"],
            "nullable": true,
            "description": "Способ получения заказа. Кода получения в admin-ответах нет — он секрет покупателя."
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminOrderLifecycleEvent"
            }
          }
        }
      },
      "AdminPlaceCounterOrderRes": {
        "type": "object",
        "required": ["order", "lifecycle"],
        "properties": {
          "order": {
            "type": "object",
            "description": "Заказ ядра (schema AdminOrder базовой спеки).",
            "properties": { "id": { "type": "string" } }
          },
          "lifecycle": {
            "$ref": "#/components/schemas/AdminOrderLifecycle"
          }
        }
      },
      "AdminOrderStatusRes": {
        "type": "object",
        "required": ["order_id", "status"],
        "properties": {
          "order_id": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "AdminOrderFulfillmentRes": {
        "type": "object",
        "required": ["order_id"],
        "properties": {
          "order_id": { "type": "string" },
          "fulfillment": {
            "type": "object",
            "description": "Созданный fulfillment ядра.",
            "properties": { "id": { "type": "string" } }
          }
        }
      }
    }
  }
}
