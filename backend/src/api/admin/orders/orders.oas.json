  "components": {
    "schemas": {
      "AdminOrderLineInput": {
        "type": "object",
        "required": [
          "id",
          "quantity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Id позиции заказа (order line item)."
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "AdminCompleteAssembly": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/AdminOrderLineInput"
            }
          },
          "location_id": {
            "type": "string",
            "description": "Склад отгрузки (по умолчанию — из заказа)."
          }
        }
      },
      "AdminShipOrder": {
        "type": "object",
        "required": [
          "fulfillment_id",
          "items"
        ],
        "properties": {
          "fulfillment_id": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminOrderLineInput"
            }
          }
        }
      },
      "AdminDeliverOrder": {
        "type": "object",
        "required": [
          "fulfillment_id"
        ],
        "properties": {
          "fulfillment_id": {
            "type": "string"
          },
          "delivery_code": {
            "type": "string",
            "description": "Код получения от покупателя — обязателен для заказов со способом delivery."
          }
        }
      },
      "AdminCancelOrder": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "Причина отмены (опционально; логируется)."
          }
        }
      },
      "AdminOrderLifecycleOrder": {
        "type": "object",
        "description": "Заказ строкой очереди панели продавца: всё уже готово к отрисовке — имя плательщика, признак юрлица, число позиций, итог, состояние оплаты и адрес доставки считает бэкенд.",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "display_id": {
            "type": "integer",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "customer_name": {
            "type": "string",
            "nullable": true,
            "description": "Человекочитаемый плательщик: название компании → ФИО → телефон → email."
          },
          "company_id": {
            "type": "string",
            "nullable": true,
            "description": "Компания-покупатель, если заказ оформлен от имени юрлица."
          },
          "is_company": {
            "type": "boolean",
            "description": "Заказ оформлен юрлицом (нужен счёт и АВР)."
          },
          "item_count": {
            "type": "integer",
            "description": "Число позиций заказа."
          },
          "total": {
            "type": "number",
            "nullable": true,
            "description": "Итог заказа в основной единице валюты (тенге — целые)."
          },
          "currency_code": {
            "type": "string",
            "nullable": true
          },
          "payment_state": {
            "type": "string",
            "nullable": true,
            "enum": [
              "paid",
              "awaiting",
              "canceled"
            ],
            "description": "Состояние оплаты для панели: деньги получены/авторизованы, ждём оплату или оплата отменена. null — платёжной сессии нет."
          },
          "address": {
            "type": "string",
            "nullable": true,
            "description": "Адрес доставки одной строкой (улица, город)."
          }
        }
      },
      "AdminOrderLifecycleCounts": {
        "type": "object",
        "description": "Счётчики для чипов-фильтров экрана «Заказы»: всего и по каждому бизнес-статусу при текущем поиске/способе получения.",
        "required": [
          "total",
          "by_status"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "by_status": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "overdue": {
            "type": "integer",
            "description": "Сколько заказов вышли за срок своей стадии при текущих фильтрах."
          }
        }
      },
      "AdminOrderLifecycle": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "confirmed",
              "assembling",
              "partially_assembled",
              "assembled",
              "in_delivery",
              "delivered",
              "closed",
              "canceled",
              "returned"
            ]
          },
          "previous_status": {
            "type": "string",
            "nullable": true
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "delivery_method": {
            "type": "string",
            "enum": [
              "delivery"
            ],
            "description": "Способ получения заказа."
          },
