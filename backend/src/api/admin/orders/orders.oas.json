      "post": {
        "operationId": "PostOrdersIdLifecycleReschedule",
        "summary": "Reschedule Order Delivery (Admin)",
        "description": "Перенос доставки на другое окно (T5.6b): продавец двигает слот по звонку покупателя. Статус заказа не меняется; «кто и почему подвинул» пишется в лог заказа записью kind=slot.",
        "tags": [
          "Orders"
        ],
        "security": [
          {
            "jwt_token": []
