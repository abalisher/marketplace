{
  "paths": {
    "/admin/counter-carts": {
      "post": {
        "operationId": "PostCounterCarts",
        "summary": "Create POS Cart",
        "description": "POS-корзина продавца (продажа у окна склада): создаётся с контекстом склада (регион, канал продаж, адрес) и pickup-опцией 0 ₸ этого склада. Дальше — line-items, оплата (payment/kaspi | payment/cash) и POST /admin/counter-orders.",
        "tags": ["Counter Carts"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminCreateCounterCart" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Созданная POS-корзина.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminCounterCartRes" }
              }
            }
          }
        }
      }
    },
    "/admin/counter-carts/{id}": {
      "get": {
        "operationId": "GetCounterCartsId",
        "summary": "Get POS Cart",
        "description": "Текущее состояние POS-корзины (позиции, тоталы, платёжные сессии). Обычная покупательская корзина по этому роуту недоступна (404).",
        "tags": ["Counter Carts"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "POS-корзина.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminCounterCartRes" }
              }
            }
          }
        }
      }
    },
    "/admin/counter-carts/{id}/line-items": {
      "post": {
        "operationId": "PostCounterCartsIdLineItems",
        "summary": "Add POS Cart Line Item",
        "description": "Добавить позицию в POS-корзину. Повторное добавление того же варианта суммируется ядром.",
        "tags": ["Counter Carts"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminAddCounterCartItem" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Корзина после добавления позиции.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminCounterCartRes" }
              }
            }
          }
        }
      }
    },
    "/admin/counter-carts/{id}/line-items/{line_id}": {
      "post": {
        "operationId": "PostCounterCartsIdLineItemsLineId",
        "summary": "Update POS Cart Line Item",
        "description": "Сменить количество позиции POS-корзины.",
        "tags": ["Counter Carts"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "line_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminUpdateCounterCartItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Корзина после изменения позиции.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminCounterCartRes" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "DeleteCounterCartsIdLineItemsLineId",
        "summary": "Remove POS Cart Line Item",
        "description": "Убрать позицию из POS-корзины.",
        "tags": ["Counter Carts"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "line_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Корзина после удаления позиции.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminCounterCartRes" }
              }
            }
          }
        }
      }
    },
    "/admin/counter-carts/{id}/payment/kaspi": {
      "post": {
        "operationId": "PostCounterCartsIdPaymentKaspi",
        "summary": "Init POS Cart Kaspi Payment",
        "description": "Инициализация Kaspi-оплаты POS-корзины с partner-стороны: payment collection + сессия Kaspi (инвойс + QR для показа покупателю). Идемпотентен. Ответ — как у store-варианта.",
        "tags": ["Counter Carts"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StoreInitKaspiPayment" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kaspi-оплата: QR/ссылка + статус сессии.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StoreKaspiPaymentRes" }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "GetCounterCartsIdPaymentKaspi",
        "summary": "Get POS Cart Kaspi Payment Status",
        "description": "Статус Kaspi-оплаты POS-корзины (polling): синхронизирует сессию с инвойсом; оплачено → authorized (можно пробивать POST /admin/counter-orders).",
        "tags": ["Counter Carts"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Kaspi-оплата: QR/ссылка + статус сессии.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StoreKaspiPaymentRes" }
              }
            }
          }
        }
      }
    },
    "/admin/counter-carts/{id}/payment/cash": {
      "post": {
        "operationId": "PostCounterCartsIdPaymentCash",
        "summary": "Init POS Cart Cash Payment",
        "description": "Оплата наличными/переводом у окна: сессия pp_system_default (авторизуется при завершении корзины, деньги продавец принимает физически). Идемпотентен; вызов после Kaspi-инициализации переключает способ оплаты.",
        "tags": ["Counter Carts"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Платёжная сессия наличной оплаты.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminCashPaymentRes"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminCreateCounterCart": {
        "type": "object",
        "required": ["location_id"],
        "properties": {
          "location_id": {
            "type": "string",
            "description": "Склад продавца: его pickup-опция и адрес станут контекстом корзины."
          },
          "region_id": {
            "type": "string",
            "description": "Обязателен, только если в системе несколько регионов."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email покупателя для письма о заказе; без него — служебный pos@marketplace.local."
          },
          "phone": {
            "type": "string",
            "description": "Телефон покупателя — привязка POS-заказа к покупателю (find-or-create по телефону, гэп 3). Без него продажа гостевая."
          }
        }
      },
      "AdminAddCounterCartItem": {
        "type": "object",
        "required": ["variant_id", "quantity"],
        "properties": {
          "variant_id": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      },
      "AdminUpdateCounterCartItem": {
        "type": "object",
        "required": ["quantity"],
        "properties": {
          "quantity": { "type": "integer", "minimum": 1 }
        }
      },
      "AdminCounterCartItem": {
        "type": "object",
        "required": ["id", "title", "quantity", "unit_price"],
        "properties": {
          "id": { "type": "string" },
          "variant_id": { "type": "string", "nullable": true },
          "product_id": { "type": "string", "nullable": true },
          "title": { "type": "string" },
          "product_title": { "type": "string", "nullable": true },
          "variant_title": { "type": "string", "nullable": true },
          "thumbnail": { "type": "string", "nullable": true },
          "quantity": { "type": "integer" },
          "unit_price": { "type": "number" }
        }
      },
      "AdminCounterCartCreditLine": {
        "type": "object",
        "required": ["id", "amount"],
        "properties": {
          "id": { "type": "string" },
          "amount": { "type": "number" }
        }
      },
      "AdminCounterCartShippingMethod": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "AdminCounterCartPaymentSession": {
        "type": "object",
        "required": ["id", "provider_id", "status"],
        "properties": {
          "id": { "type": "string" },
          "provider_id": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "AdminCounterCart": {
        "type": "object",
        "required": [
          "id",
          "currency_code",
          "items",
          "subtotal",
          "item_total",
          "shipping_total",
          "total",
          "credit_lines",
          "shipping_methods",
          "payment_sessions"
        ],
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string", "nullable": true },
          "currency_code": { "type": "string" },
          "region_id": { "type": "string", "nullable": true },
          "sales_channel_id": { "type": "string", "nullable": true },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "counter: true + location_id склада продавца."
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "created_at": { "type": "string", "format": "date-time" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AdminCounterCartItem" }
          },
          "subtotal": { "type": "number" },
          "item_total": { "type": "number" },
          "shipping_total": { "type": "number" },
          "total": { "type": "number" },
          "credit_lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminCounterCartCreditLine"
            }
          },
          "shipping_methods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminCounterCartShippingMethod"
            }
          },
          "payment_collection_id": { "type": "string", "nullable": true },
          "payment_sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminCounterCartPaymentSession"
            }
          }
        }
      },
      "AdminCounterCartRes": {
        "type": "object",
        "required": ["cart"],
        "properties": {
          "cart": { "$ref": "#/components/schemas/AdminCounterCart" }
        }
      },
      "AdminCashPayment": {
        "type": "object",
        "required": ["payment_collection_id", "payment_session_id", "status"],
        "properties": {
          "payment_collection_id": { "type": "string" },
          "payment_session_id": { "type": "string" },
          "status": {
            "type": "string",
            "description": "Статус сессии ядра; pending — авторизуется при завершении корзины."
          }
        }
      },
      "AdminCashPaymentRes": {
        "type": "object",
        "required": ["payment"],
        "properties": {
          "payment": { "$ref": "#/components/schemas/AdminCashPayment" }
        }
      }
    }
  }
}
