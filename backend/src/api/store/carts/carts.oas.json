{
  "paths": {
    "/store/carts/{id}/payment/kaspi": {
      "post": {
        "operationId": "PostCartsIdPaymentKaspi",
        "summary": "Initialize Kaspi Payment",
        "description": "Инициализация оплаты корзины через Kaspi: создаёт payment collection ядра на сумму корзины (если ещё нет) и платёжную сессию провайдера Kaspi — внутри создаётся инвойс, в ответе QR/ссылка для оплаты. Идемпотентен: повторный вызов возвращает существующую сессию. 404 — корзина не принадлежит покупателю.",
        "tags": ["Payment"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "x-publishable-api-key",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StoreInitKaspiPayment" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Платёжная сессия Kaspi с QR/ссылкой для оплаты.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StoreKaspiPaymentRes" }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "GetCartsIdPaymentKaspi",
        "summary": "Get Kaspi Payment Status",
        "description": "Статус оплаты Kaspi (polling): синхронизирует платёжную сессию с состоянием инвойса. Оплачено → status=authorized (можно оформлять заказ POST /store/orders). 400 — оплата для корзины не инициализирована; 404 — корзина не принадлежит покупателю.",
        "tags": ["Payment"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "x-publishable-api-key",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Актуальный статус платёжной сессии Kaspi.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StoreKaspiPaymentRes" }
              }
            }
          }
        }
      }
    },
    "/store/carts/{id}/bonus": {
      "post": {
        "operationId": "PostCartsIdBonus",
        "summary": "Apply Bonus to Cart",
        "description": "Применить бонусы к корзине как частичную оплату: сумма к оплате уменьшается, остаток оплачивается обычным способом (Kaspi). Повторный вызов заменяет сумму. Ограничения: не более max_spend_percent от суммы заказа и не более баланса счёта (иначе 400). Если оплата Kaspi уже была инициализирована, её сессия сбрасывается (сумма изменилась) — инициализировать оплату заново. 404 — корзина не принадлежит покупателю.",
        "tags": ["Bonus"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "x-publishable-api-key",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StoreApplyCartBonus" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Применённая бонусная сумма и тотал корзины к оплате.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StoreCartBonusRes" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "DeleteCartsIdBonus",
        "summary": "Remove Bonus from Cart",
        "description": "Снять применённые бонусы с корзины (идемпотентен). Сумма к оплате восстанавливается; инициализированная оплата Kaspi сбрасывается — инициализировать заново. 404 — корзина не принадлежит покупателю.",
        "tags": ["Bonus"],
        "security": [{ "jwt_token": [] }, { "cookie_auth": [] }],
        "parameters": [
          {
            "name": "x-publishable-api-key",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Нулевая бонусная сумма и восстановленный тотал корзины.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StoreCartBonusRes" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StoreInitKaspiPayment": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string",
            "enum": ["pending", "paid", "canceled", "error"],
            "description": "ТОЛЬКО для мока (dev/тесты): детерминированный исход оплаты инвойса. В live-режиме игнорируется."
          }
        }
      },
      "StoreKaspiPayment": {
        "type": "object",
        "required": ["payment_collection_id", "payment_session_id", "status"],
        "properties": {
          "payment_collection_id": {
            "type": "string",
            "description": "Payment collection ядра, привязанная к корзине."
          },
          "payment_session_id": {
            "type": "string",
            "description": "Платёжная сессия провайдера Kaspi."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "requires_more",
              "authorized",
              "captured",
              "canceled",
              "error"
            ],
            "description": "Статус сессии ядра. authorized/captured — оплачено, можно оформлять заказ."
          },
          "kaspi_state": {
            "type": "string",
            "nullable": true,
            "description": "Состояние инвойса Kaspi (pending|paid|canceled|error)."
          },
          "qr_payload": {
            "type": "string",
            "nullable": true,
            "description": "Данные для отрисовки QR-кода оплаты."
          },
          "payment_url": {
            "type": "string",
            "nullable": true,
            "description": "Ссылка на оплату (редирект в приложение Kaspi)."
          }
        }
      },
      "StoreKaspiPaymentRes": {
        "type": "object",
        "required": ["payment"],
        "properties": {
          "payment": { "$ref": "#/components/schemas/StoreKaspiPayment" }
        }
      },
      "StoreApplyCartBonus": {
        "type": "object",
        "required": ["amount"],
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 1,
            "description": "Бонусная сумма в главных единицах валюты (KZT без тиынов)."
          }
        }
      },
      "StoreCartBonus": {
        "type": "object",
        "required": ["amount", "cart_total", "currency_code"],
        "properties": {
          "amount": {
            "type": "integer",
            "description": "Применённая к корзине бонусная сумма (0 — бонусы не применены)."
          },
          "cart_total": {
            "type": "number",
            "description": "Тотал корзины к оплате — уже за вычетом бонусов."
          },
          "currency_code": {
            "type": "string",
            "description": "Валюта корзины."
          }
        }
      },
      "StoreCartBonusRes": {
        "type": "object",
        "required": ["bonus"],
        "properties": {
          "bonus": { "$ref": "#/components/schemas/StoreCartBonus" }
        }
      }
    }
  }
}
