# Окружение прод-стенда. Скопировать в infra/prod/.env НА СЕРВЕРЕ и заполнить.
# Реальный .env в git не попадает; секреты генерирует deploy-server.sh при
# первом запуске, если файла ещё нет.

# --- Публичный адрес стенда. ---
# Из этого значения собираются CORS, база ссылок на фото товаров и PDF
# документов и NEXT_PUBLIC_BASE_URL витрины.
#
# Основной вход — постоянный домен через именованный туннель Cloudflare
# (см. TUNNEL_RUN ниже и раздел «Домен» в README). Запасной — вход по IP
# https://95.47.96.14:4440: адрес тоже постоянный, но браузер предупреждает о
# самоподписанном сертификате.
#
# МЕНЯТЬ ЭТО ЗНАЧЕНИЕ РУКАМИ НЕ НУЖНО — адрес размазан по пяти строкам файла и
# лежит абсолютными ссылками в базе: bash set-origin.sh <адрес>.
PUBLIC_ORIGIN=https://stand.kenenai.com

# --- Именованный туннель Cloudflare: постоянный адрес на своём домене. ---
# Хвост команды cloudflared целиком. Пусто — быстрый туннель со случайным
# адресом (запасной режим). Для постоянного адреса вписать значение вида
#   TUNNEL_RUN="run --token eyJhIjoi…"
# КАВЫЧКИ ОБЯЗАТЕЛЬНЫ: deploy-server.sh читает этот файл через `source`, и без
# них bash принимает `--token` за команду, а развёртывание падает на
# «--token: command not found». Docker Compose кавычки снимает сам.
# Токен выдаёт панель Cloudflare при создании туннеля; он секрет, поэтому на
# сервере его задают скрытым вводом: bash set-env.sh TUNNEL_RUN
# (кавычки скрипт проставит сам).
TUNNEL_RUN=

# --- База данных. ---
POSTGRES_USER=medusa
POSTGRES_PASSWORD=
POSTGRES_DB=marketplace

# --- Секреты Medusa. Срок жизни токена — 7 дней (medusa-config.ts). ---
JWT_SECRET=
COOKIE_SECRET=

# --- CORS. Панель (/app) и сборщик (/picker) живут на том же origin, что API. ---
# Перечислены ОБА входа — домен и запасной по IP: иначе после переезда на домен
# вход по IP отвечал бы ошибкой CORS. set-origin.sh добавляет новый адрес к
# списку, а не затирает его, ровно по этой причине.
STORE_CORS=https://stand.kenenai.com,https://95.47.96.14:4440
ADMIN_CORS=https://stand.kenenai.com,https://95.47.96.14:4440
AUTH_CORS=https://stand.kenenai.com,https://95.47.96.14:4440

# --- База ссылок на файлы. ---
# Каталог хранит абсолютные URL фото (/media/:file), документы — PDF
# (/static/:file). Адрес ОДИН, запасной сюда не подставить: при входе по IP
# файлы всё равно поедут с домена (то есть через туннель).
STATIC_BASE_URL=https://stand.kenenai.com

# --- Публикуемый ключ витрины. ---
# Заполняется АВТОМАТИЧЕСКИ после bootstrap-store.ts: ключ появляется только
# вместе с каналом продаж, а витрина вшивает его в бандл на сборке.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# --- ИИ: ассистент покупателя и разбор накладных. ---
# Без ключа чат и /admin/procurement/parse-invoice отвечают понятной ошибкой,
# остальной магазин работает. На показах модель переключают на gemini-3.6-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Kaspi Pay. Боевых ключей мерчанта нет — транспорт mock. ---
KASPI_MODE=mock
KASPI_MERCHANT_ID=
KASPI_API_KEY=
KASPI_API_URL=
KASPI_WEBHOOK_SECRET=
# Исход мок-оплаты для проходимого чекаута витрины.
KASPI_MOCK_SCENARIO=paid
# Кнопка «Оплатить тестово» на витрине (вшивается в сборку образа витрины).
# Включается только значением true; не задано — false.
NEXT_PUBLIC_KASPI_MOCK=false

# --- Вход покупателя по номеру телефона. ---
# SMS-провайдера нет (гейт В у владельца), поэтому dev-канал ОСТАЁТСЯ включённым
# и на сервере: код входа возвращается полем dev_code и пишется в лог. Выключить
# можно только вместе с подключением провайдера — иначе вход перестанет работать.
PHONE_OTP_DEV_CHANNEL=true
PHONE_OTP_TTL_SECONDS=300
PHONE_OTP_MAX_ATTEMPTS=5
PHONE_OTP_RESEND_SECONDS=60
PHONE_OTP_CODE_LENGTH=6

# --- Магазин и сроки. ---
SHOP_TIME_ZONE=Asia/Almaty
DASHBOARD_LOW_STOCK_THRESHOLD=10
DASHBOARD_STAGE_REPORT_DAYS=30
DISPUTE_SLA_HOURS=24

# --- Фича-флаг «юрлица»: на MVP выключен (разворот владельца 2026-08-25). ---
# Значение сквозное: витрина собирается из него же.
FEATURE_COMPANIES=false

# --- Учётки панели. На сервере задать свои значения. ---
ADMIN_EMAIL=admin@stroymarket.kz
ADMIN_PASSWORD=
SELLER_EMAIL=seller@stroymarket.kz
SELLER_PASSWORD=
PICKER_PASSWORD=

# --- Витрина. ---
REVALIDATE_SECRET=
