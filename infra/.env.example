# Скопируй в .env рядом (infra/.env) и заполни. Реальный .env в git не попадает.

# --- База данных / кэш ---
POSTGRES_USER=medusa
POSTGRES_PASSWORD=medusa
POSTGRES_DB=marketplace
DATABASE_URL=postgres://medusa:medusa@localhost:5432/marketplace
REDIS_URL=redis://localhost:6379

# --- Medusa (заполняется при скаффолдинге) ---
JWT_SECRET=change_me
COOKIE_SECRET=change_me
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# --- Интеграции (запросить у клиента / провайдеров) ---
KASPI_MERCHANT_ID=
KASPI_API_KEY=
SMS_PROVIDER_API_KEY=
ANTHROPIC_API_KEY=
STT_PROVIDER_API_KEY=
MAPS_API_KEY=
